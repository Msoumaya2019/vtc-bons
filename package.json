{
  "name": "vtc-bons",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bons de commande et factures pour chauffeur VTC. 100 % local, hors connexion.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "icons": "node scripts/generate-icons.mjs",
    "verifier:binaires": "node scripts/verifier-rollup.mjs",
    "verifier:raccourci": "node scripts/verifier-raccourci.mjs",
    "verifier:flux": "node scripts/check-workflows.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/share": "^8.0.2",
    "@react-pdf/renderer": "^4.1.6",
    "dexie": "^4.0.11",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.0.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "//": "Les dépendances optionnelles ci-dessous ne servent pas au code : elles forcent npm à inscrire dans package-lock.json les binaires natifs de Rollup pour Linux et macOS. Sans elles, npm ci produit une installation où Rollup ne démarre pas sur la CI (bug npm #4828). Leurs versions doivent rester égales à celle de Rollup — la CI le vérifie. Voir README, section « Binaires natifs de Rollup ».",
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.63.3",
    "@rollup/rollup-darwin-x64": "4.63.3",
    "@rollup/rollup-linux-x64-gnu": "4.63.3"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
